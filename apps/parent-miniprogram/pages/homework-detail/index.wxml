<view wx:if="{{testMode}}" class="test-banner">开发测试环境 · 仅使用受控测试数据</view><view class="student-bar" wx:if="{{student}}"><view class="row grow" bindtap="openStudents"><view class="avatar small">学</view><view>{{student.name}} <text class="small">{{student.grade}} ▾</text></view></view><view bindtap="go" data-page="notifications">通知<text wx:if="{{data.unread}}" class="badge">{{data.unread}}</text></view></view><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error-box"><view>{{error}}</view><button class="ghost" size="mini" bindtap="load">重新加载</button></view><view wx:if="{{detail}}"><view class="card"><view class="row between"><view class="title grow">{{detail.title}}</view><text class="pill">{{detail.statusText}}</text><text wx:if="{{detail.overdue}}" class="pill red-pill">已逾期 · {{detail.late_policy==='allow'?'允许补交':'请联系老师'}}</text></view><view class="sub">{{detail.teacher}} · 布置于 {{detail.date}}</view><view class="body-text soft space">{{detail.body}}</view><media-files files="{{detail.files}}" student="{{studentId}}"/><view class="pill space">截止 {{detail.due||'未设置'}}</view></view><view class="card" wx:if="{{detail.status==='todo'||detail.status==='returned'}}"><view class="section-title"><view class="dot"/>{{detail.status==='returned'?'重新提交作业':'提交作业'}}</view><view class="images"><view class="upload" bindtap="selectPictures">＋</view><view wx:for="{{files}}" wx:key="id" class="image-wrap"><image src="{{item.local}}" mode="aspectFill" bindtap="previewPicture" data-url="{{item.local}}"/><text class="remove" bindtap="removePicture" data-id="{{item.id}}">×</text></view></view><textarea value="{{text}}" bindinput="input" maxlength="4000" placeholder="填写文字说明，请勿包含无关个人信息"/><button class="primary" bindtap="submitHomework" loading="{{busy}}" disabled="{{busy}}">提交作业</button><view class="sub center">单次最多 {{detail.limits.image_count}} 张；单张 {{detail.limits.image_bytes/1048576}} MB{{detail.limits.confirmed?'':'（开发暂定参数）'}}</view></view><view class="card" wx:for="{{detail.history}}" wx:key="id"><view class="section-title"><view class="dot"/>第 {{item.revision}} 次提交<text class="pill">{{item.statusText}}</text></view><view class="sub">{{item.date}}</view><view class="body-text">{{item.text}}</view><media-files files="{{item.files}}" student="{{studentId}}"/><view wx:for="{{item.feedback}}" wx:for-item="feedback" wx:key="id" class="feedback"><view class="row between"><view class="title">{{feedback.teacher}}的反馈</view><text class="pill green-pill">{{feedback.grade}}</text></view><view class="body-text">{{feedback.text}}</view><media-files files="{{feedback.files}}" student="{{studentId}}"/></view><view class="sub" wx:if="{{!item.feedback.length}}">已保存至服务器，等待老师批改</view></view></view><view wx:if="{{!student && !loading && !error && name!=='profile' && name!=='settings' && name!=='teachers' && name!=='teacher-detail' && name!=='content' && name!=='me'}}" class="card empty"><view class="title">暂未关联学员</view><view class="sub">请联系机构核对报名时预留的手机号。机构完成预登记后，重新授权即可关联。</view><button class="primary" bindtap="support">联系机构</button></view><view wx:if="{{showStudents}}" class="mask" bindtap="closeStudents"><view class="sheet"><view class="sheet-title">选择学员</view><view class="sheet-body"><view wx:for="{{students}}" wx:key="id" class="list-item {{item.id===studentId?'soft':''}}" bindtap="chooseStudent" data-id="{{item.id}}"><view class="avatar">学</view><view class="grow"><view class="title">{{item.name}} {{item.id===studentId?'✓':''}}</view><view class="sub">{{item.grade}} · 剩余 {{item.remaining}} 课时</view></view></view></view><view class="sheet-footer"><button class="ghost" bindtap="support">管理关联（联系机构）</button></view></view></view><view wx:if="{{showSupport}}" class="mask"><view class="sheet"><view class="sheet-title">企业微信客服</view><view class="sheet-body center"><image wx:if="{{supportUrl}}" src="{{supportUrl}}" class="qr" mode="aspectFit" show-menu-by-longpress/><view wx:else class="empty">机构尚未配置客服二维码</view><view class="body-text">{{support.text||'约课、调课、报名与缴费由机构线下办理。请通过已知机构联系方式咨询。'}}</view><view class="error" wx:if="{{supportError}}">{{supportError}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeSupport">关闭</button></view></view></view><view class="safe-bottom"/>