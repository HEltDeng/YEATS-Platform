<view wx:if="{{testMode}}" class="test-banner">开发测试环境 · 仅使用受控测试数据</view><view class="student-bar" wx:if="{{student}}"><view class="row grow" bindtap="openStudents"><view class="avatar small">学</view><view>{{student.name}} <text class="small">{{student.grade}} ▾</text></view></view><view bindtap="go" data-page="notifications">通知<text wx:if="{{data.unread}}" class="badge">{{data.unread}}</text></view></view><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error-box"><view>{{error}}</view><button class="ghost" size="mini" bindtap="load">重新加载</button></view><view class="card" wx:if="{{detail}}"><view class="title">{{detail.title}}</view><view class="sub">{{detail.pathText}}</view><view class="body-text">{{detail.text}}</view><media-files files="{{detail.files}}" student="{{studentId}}"/><view class="notice">视频仅在线播放；其他文件按权限查看和下载。</view></view><view class="card"><view class="section-title"><view class="dot"/>提问与答复<text class="more" bindtap="askOpen">我要提问</text></view><view class="sub">仅提问家长与老师可见</view><view wx:for="{{detail.questions}}" wx:key="id" class="question"><view class="sub">{{item.date}}</view><view class="body-text">{{item.text}}</view><view class="reply" wx:if="{{item.reply||item.files.length}}"><view class="accent">{{item.teacher}}回复</view><view class="body-text">{{item.reply}}</view><media-files files="{{item.files}}" student="{{studentId}}"/></view><view wx:else class="sub">等待老师回复</view></view><view wx:if="{{!detail.questions.length}}" class="empty">暂无提问</view></view><view wx:if="{{showQuestion}}" class="mask"><view class="sheet"><view class="sheet-title">发起提问</view><view class="sheet-body"><textarea value="{{text}}" bindinput="input" placeholder="填写关于本知识内容的问题" maxlength="2000"/><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeQuestion">取消</button><button class="primary" bindtap="submitQuestion" loading="{{busy}}">提交提问</button></view></view></view><view wx:if="{{!student && !loading && !error && name!=='profile' && name!=='settings' && name!=='teachers' && name!=='teacher-detail' && name!=='content' && name!=='me'}}" class="card empty"><view class="title">暂未关联学员</view><view class="sub">请联系机构核对报名时预留的手机号。机构完成预登记后，重新授权即可关联。</view><button class="primary" bindtap="support">联系机构</button></view><view wx:if="{{showStudents}}" class="mask" bindtap="closeStudents"><view class="sheet"><view class="sheet-title">选择学员</view><view class="sheet-body"><view wx:for="{{students}}" wx:key="id" class="list-item {{item.id===studentId?'soft':''}}" bindtap="chooseStudent" data-id="{{item.id}}"><view class="avatar">学</view><view class="grow"><view class="title">{{item.name}} {{item.id===studentId?'✓':''}}</view><view class="sub">{{item.grade}} · 剩余 {{item.remaining}} 课时</view></view></view></view><view class="sheet-footer"><button class="ghost" bindtap="support">管理关联（联系机构）</button></view></view></view><view wx:if="{{showSupport}}" class="mask"><view class="sheet"><view class="sheet-title">企业微信客服</view><view class="sheet-body center"><image wx:if="{{supportUrl}}" src="{{supportUrl}}" class="qr" mode="aspectFit" show-menu-by-longpress/><view wx:else class="empty">机构尚未配置客服二维码</view><view class="body-text">{{support.text||'约课、调课、报名与缴费由机构线下办理。请通过已知机构联系方式咨询。'}}</view><view class="error" wx:if="{{supportError}}">{{supportError}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeSupport">关闭</button></view></view></view><view class="safe-bottom"/>