<view wx:if="{{testMode}}" class="test-banner">开发测试环境 · 仅使用受控测试数据</view><view class="student-bar" wx:if="{{student}}"><view class="row grow" bindtap="openStudents"><view class="avatar small">学</view><view>{{student.name}} <text class="small">{{student.grade}} ▾</text></view></view><view bindtap="go" data-page="notifications">通知<text wx:if="{{data.unread}}" class="badge">{{data.unread}}</text></view></view><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error-box"><view>{{error}}</view><button class="ghost" size="mini" bindtap="load">重新加载</button></view><view class="card"><view class="list-item" bindtap="subscriptions"><view class="grow title">微信订阅消息</view><text>授权 ›</text></view><view class="sub">拒绝订阅不影响学习记录、作业提交及站内通知。</view><view class="list-item" bindtap="go" data-page="content" data-kind="privacy"><view class="grow title">隐私政策</view><text>›</text></view><view class="list-item" bindtap="go" data-page="content" data-kind="agreement"><view class="grow title">用户协议</view><text>›</text></view><view class="list-item" bindtap="support"><view class="grow title">更正资料与账号注销咨询</view><text>›</text></view></view><button class="ghost margin" bindtap="logout" loading="{{busy}}">退出登录</button><view wx:if="{{!student && !loading && !error && name!=='profile' && name!=='settings' && name!=='teachers' && name!=='teacher-detail' && name!=='content' && name!=='me'}}" class="card empty"><view class="title">暂未关联学员</view><view class="sub">请联系机构核对报名时预留的手机号。机构完成预登记后，重新授权即可关联。</view><button class="primary" bindtap="support">联系机构</button></view><view wx:if="{{showStudents}}" class="mask" bindtap="closeStudents"><view class="sheet"><view class="sheet-title">选择学员</view><view class="sheet-body"><view wx:for="{{students}}" wx:key="id" class="list-item {{item.id===studentId?'soft':''}}" bindtap="chooseStudent" data-id="{{item.id}}"><view class="avatar">学</view><view class="grow"><view class="title">{{item.name}} {{item.id===studentId?'✓':''}}</view><view class="sub">{{item.grade}} · 剩余 {{item.remaining}} 课时</view></view></view></view><view class="sheet-footer"><button class="ghost" bindtap="support">管理关联（联系机构）</button></view></view></view><view wx:if="{{showSupport}}" class="mask"><view class="sheet"><view class="sheet-title">企业微信客服</view><view class="sheet-body center"><image wx:if="{{supportUrl}}" src="{{supportUrl}}" class="qr" mode="aspectFit" show-menu-by-longpress/><view wx:else class="empty">机构尚未配置客服二维码</view><view class="body-text">{{support.text||'约课、调课、报名与缴费由机构线下办理。请通过已知机构联系方式咨询。'}}</view><view class="error" wx:if="{{supportError}}">{{supportError}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeSupport">关闭</button></view></view></view><view class="safe-bottom"/>