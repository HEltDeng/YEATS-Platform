<view wx:if="{{testMode}}" class="test-banner">开发测试环境 · 仅使用受控测试数据</view><view class="student-bar" wx:if="{{student}}"><view class="row grow" bindtap="openStudents"><view class="avatar small">学</view><view>{{student.name}} <text class="small">{{student.grade}} ▾</text></view></view><view bindtap="go" data-page="notifications">通知<text wx:if="{{data.unread}}" class="badge">{{data.unread}}</text></view></view><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error-box"><view>{{error}}</view><button class="ghost" size="mini" bindtap="load">重新加载</button></view><view wx:for="{{data.classes}}" wx:key="id" class="card"><view class="row"><view class="avatar large">班</view><view><view class="title">{{item.name}}</view><view class="sub">{{item.campus}} · {{item.room}} · {{item.size}} 人</view></view></view><view class="section-title space"><view class="dot"/>任课老师</view><view class="list-item" wx:for="{{item.teachers}}" wx:for-item="teacher" wx:key="name" bindtap="go" data-page="teacher-detail" data-id="{{teacher.profile_id}}"><view class="avatar">师</view><view class="grow"><view class="title">{{teacher.name}}</view><view class="sub">{{teacher.duty}}</view></view><text class="accent" wx:if="{{teacher.profile_id}}">主页 ›</text></view></view><view class="card"><view class="section-title"><view class="dot"/>本周课表<text class="more" bindtap="toggleSchedule">{{scheduleList?'周视图':'列表视图'}}</text></view><view class="row between space"><button size="mini" class="ghost" bindtap="weekMove" data-delta="-1">上一周</button><text class="sub">{{weekLabel}}</text><button size="mini" class="ghost" bindtap="weekMove" data-delta="1">下一周</button></view><view wx:if="{{!scheduleList}}" class="week"><view class="day" wx:for="{{week}}" wx:key="label"><view class="sub">{{item.label}}</view><view>{{item.date}}</view><view wx:for="{{item.lessons}}" wx:for-item="lesson" wx:key="id" class="lesson-cell">{{lesson.time}}<view>{{lesson.title}}</view></view></view></view><view wx:if="{{scheduleList}}" class="list-item" wx:for="{{data.lessons}}" wx:key="id"><view class="grow"><view class="title">{{item.title}}</view><view class="sub">{{item.start}} · {{item.room}} · {{item.teacher}}</view></view><text class="pill">{{item.statusText}}</text></view></view><view class="card"><view class="section-title"><view class="dot"/>近期上课安排</view><view class="list-item" wx:for="{{data.lessons}}" wx:key="id"><view class="grow"><view class="title">{{item.start}}</view><view class="sub">{{item.title}} · {{item.room}} · {{item.teacher}}</view></view><text class="pill">{{item.statusText}}</text></view><view class="empty" wx:if="{{!data.lessons.length}}">暂无排课</view></view><view wx:if="{{!student && !loading && !error && name!=='profile' && name!=='settings' && name!=='teachers' && name!=='teacher-detail' && name!=='content' && name!=='me'}}" class="card empty"><view class="title">暂未关联学员</view><view class="sub">请联系机构核对报名时预留的手机号。机构完成预登记后，重新授权即可关联。</view><button class="primary" bindtap="support">联系机构</button></view><view wx:if="{{showStudents}}" class="mask" bindtap="closeStudents"><view class="sheet"><view class="sheet-title">选择学员</view><view class="sheet-body"><view wx:for="{{students}}" wx:key="id" class="list-item {{item.id===studentId?'soft':''}}" bindtap="chooseStudent" data-id="{{item.id}}"><view class="avatar">学</view><view class="grow"><view class="title">{{item.name}} {{item.id===studentId?'✓':''}}</view><view class="sub">{{item.grade}} · 剩余 {{item.remaining}} 课时</view></view></view></view><view class="sheet-footer"><button class="ghost" bindtap="support">管理关联（联系机构）</button></view></view></view><view wx:if="{{showSupport}}" class="mask"><view class="sheet"><view class="sheet-title">企业微信客服</view><view class="sheet-body center"><image wx:if="{{supportUrl}}" src="{{supportUrl}}" class="qr" mode="aspectFit" show-menu-by-longpress/><view wx:else class="empty">机构尚未配置客服二维码</view><view class="body-text">{{support.text||'约课、调课、报名与缴费由机构线下办理。请通过已知机构联系方式咨询。'}}</view><view class="error" wx:if="{{supportError}}">{{supportError}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeSupport">关闭</button></view></view></view><view class="safe-bottom"/>