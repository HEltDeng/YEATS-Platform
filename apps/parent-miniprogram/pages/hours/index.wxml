<view wx:if="{{testMode}}" class="test-banner">开发测试环境 · 仅使用受控测试数据</view><view class="student-bar" wx:if="{{student}}"><view class="row grow" bindtap="openStudents"><view class="avatar small">学</view><view>{{student.name}} <text class="small">{{student.grade}} ▾</text></view></view><view bindtap="go" data-page="notifications">通知<text wx:if="{{data.unread}}" class="badge">{{data.unread}}</text></view></view><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error-box"><view>{{error}}</view><button class="ghost" size="mini" bindtap="load">重新加载</button></view><view wx:if="{{data}}"><view class="hero"><view class="row between"><text>{{student.name}} · 我的课时</text><text bindtap="go" data-page="ledger">明细 ›</text></view><view class="stats"><view><view class="number">{{data.total}}</view>总课时</view><view bindtap="go" data-page="ledger"><view class="number">{{data.attended_lessons}}</view>已上课节</view><view><view class="number">{{data.remaining}}</view>剩余课时</view></view><view class="row between small"><text>消耗 {{data.consumed}} 课时</text><text>{{data.progress}}%</text></view><progress percent="{{data.progress}}" activeColor="#ffffff" backgroundColor="#ffffff55" stroke-width="6"/></view><view class="card"><view class="section-title"><view class="dot"/>课时包信息</view><view class="list-item" wx:for="{{data.packages}}" wx:key="id"><view class="avatar blue">▣</view><view class="grow"><view class="title">{{item.name}}</view><view class="sub">{{item.granted}} 课时</view></view><text class="sub">{{item.valid_until||'未设有效期'}}</text></view><view class="empty" wx:if="{{!data.packages.length}}">暂无课时包</view></view><view class="card"><view class="section-title"><view class="dot"/>最近消耗<text class="more" bindtap="go" data-page="ledger">全部明细 ›</text></view><view class="list-item" wx:for="{{data.entries}}" wx:key="id"><view class="grow"><view class="title">{{item.lesson.title||item.reason}}</view><view class="sub">{{item.lesson.start||item.date}} · {{item.lesson.teacher}}</view></view><text class="accent">{{item.amount}} 课时</text></view></view><view class="notice">请假 / 缺课不消耗课时，调课按实际课节消耗。更正保留流水记录。</view></view><view wx:if="{{!student && !loading && !error && name!=='profile' && name!=='settings' && name!=='teachers' && name!=='teacher-detail' && name!=='content' && name!=='me'}}" class="card empty"><view class="title">暂未关联学员</view><view class="sub">请联系机构核对报名时预留的手机号。机构完成预登记后，重新授权即可关联。</view><button class="primary" bindtap="support">联系机构</button></view><view wx:if="{{showStudents}}" class="mask" bindtap="closeStudents"><view class="sheet"><view class="sheet-title">选择学员</view><view class="sheet-body"><view wx:for="{{students}}" wx:key="id" class="list-item {{item.id===studentId?'soft':''}}" bindtap="chooseStudent" data-id="{{item.id}}"><view class="avatar">学</view><view class="grow"><view class="title">{{item.name}} {{item.id===studentId?'✓':''}}</view><view class="sub">{{item.grade}} · 剩余 {{item.remaining}} 课时</view></view></view></view><view class="sheet-footer"><button class="ghost" bindtap="support">管理关联（联系机构）</button></view></view></view><view wx:if="{{showSupport}}" class="mask"><view class="sheet"><view class="sheet-title">企业微信客服</view><view class="sheet-body center"><image wx:if="{{supportUrl}}" src="{{supportUrl}}" class="qr" mode="aspectFit" show-menu-by-longpress/><view wx:else class="empty">机构尚未配置客服二维码</view><view class="body-text">{{support.text||'约课、调课、报名与缴费由机构线下办理。请通过已知机构联系方式咨询。'}}</view><view class="error" wx:if="{{supportError}}">{{supportError}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeSupport">关闭</button></view></view></view><view class="safe-bottom"/>