<view wx:if="{{testMode}}" class="test-banner">开发测试环境 · 仅使用受控测试数据</view><view class="student-bar" wx:if="{{student}}"><view class="row grow" bindtap="openStudents"><view class="avatar small">学</view><view>{{student.name}} <text class="small">{{student.grade}} ▾</text></view></view><view bindtap="go" data-page="notifications">通知<text wx:if="{{data.unread}}" class="badge">{{data.unread}}</text></view></view><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error-box"><view>{{error}}</view><button class="ghost" size="mini" bindtap="load">重新加载</button></view><view wx:if="{{student}}"><view class="home-cap"><text>{{student.classes[0].campus}} · {{student.classes[0].name}}</text><text class="light-pill">剩余 {{data.hours.remaining}} 课时</text></view><swiper wx:if="{{banners.length}}" class="banner" indicator-dots autoplay circular><swiper-item wx:for="{{banners}}" wx:key="id"><view class="banner-inner" bindtap="go" data-page="content" data-kind="courses"><image wx:if="{{item.imageUrl}}" class="banner-image" src="{{item.imageUrl}}" mode="aspectFill"/><view class="banner-title">{{item.title}}</view><view class="banner-sub">{{item.text}}</view></view></swiper-item></swiper><view wx:else class="banner banner-inner"><view class="banner-title">叶芝英语</view><view class="banner-sub">陪伴每一次学习与成长</view></view><view wx:for="{{announcements}}" wx:key="id" class="notice" bindtap="go" data-page="content" data-kind="announcement">📢 {{item.title}}</view><view class="card"><view class="grid4"><view class="entry" bindtap="go" data-page="hours"><view class="entry-icon">⏱</view>我的课时</view><view class="entry" bindtap="go" data-page="homework"><view wx:if="{{data.badges.homework}}" class="entry-badge">{{data.badges.homework}}</view><view class="entry-icon">📝</view>今日作业</view><view class="entry" bindtap="go" data-page="knowledge"><view wx:if="{{data.badges.knowledge}}" class="entry-badge">{{data.badges.knowledge}}</view><view class="entry-icon">📚</view>班级知识库</view><view class="entry" bindtap="go" data-page="teachers"><view class="entry-icon">👩‍🏫</view>师资展示</view><view class="entry" bindtap="go" data-page="tests"><view wx:if="{{data.badges.tests}}" class="entry-badge">{{data.badges.tests}}</view><view class="entry-icon">🎯</view>随堂测试</view><view class="entry" bindtap="go" data-page="attendance"><view class="entry-icon">✓</view>签到记录</view><view class="entry" bindtap="go" data-page="schedule"><view class="entry-icon">📅</view>上课课表</view><view class="entry" bindtap="go" data-page="recordings"><view wx:if="{{data.badges.recordings}}" class="entry-badge">{{data.badges.recordings}}</view><view class="entry-icon">▶</view>在线课程</view></view></view><view class="card"><view class="section-title"><view class="dot"/>今日学情<text class="pill">{{data.today}}</text><text class="more" bindtap="go" data-page="homework">全部 ›</text></view><view class="list-item" wx:for="{{data.homework}}" wx:key="id" bindtap="go" data-page="homework-detail" data-id="{{item.id}}"><view class="avatar pink">📝</view><view class="grow"><view class="title">{{item.title}}</view><view class="sub">{{item.teacher}} · 截止 {{item.due||'未设置'}}</view></view><text class="pill">{{item.statusText}}</text></view><view class="empty" wx:if="{{!data.homework.length}}">暂无作业记录</view><view class="list-item" wx:for="{{data.tests}}" wx:key="id" bindtap="go" data-page="tests"><view class="avatar blue">🎯</view><view class="grow"><view class="title">{{item.title}}</view><view class="sub">{{item.score}}</view></view><text class="pill">查看</text></view></view><view class="card"><view class="section-title"><view class="dot"/>叶芝教学服务<text class="more" bindtap="go" data-page="content" data-kind="services">了解详情 ›</text></view><view class="grid3"><view class="entry" bindtap="go" data-page="content" data-kind="introduction"><view class="entry-icon">🎓</view>机构介绍</view><view class="entry" bindtap="go" data-page="content" data-kind="courses"><view class="entry-icon">📖</view>年级课程</view><view class="entry" bindtap="go" data-page="content" data-kind="enrollment"><view class="entry-icon">▤</view>报名须知</view></view></view></view><view wx:if="{{!student && !loading && !error && name!=='profile' && name!=='settings' && name!=='teachers' && name!=='teacher-detail' && name!=='content' && name!=='me'}}" class="card empty"><view class="title">暂未关联学员</view><view class="sub">请联系机构核对报名时预留的手机号。机构完成预登记后，重新授权即可关联。</view><button class="primary" bindtap="support">联系机构</button></view><view wx:if="{{showStudents}}" class="mask" bindtap="closeStudents"><view class="sheet"><view class="sheet-title">选择学员</view><view class="sheet-body"><view wx:for="{{students}}" wx:key="id" class="list-item {{item.id===studentId?'soft':''}}" bindtap="chooseStudent" data-id="{{item.id}}"><view class="avatar">学</view><view class="grow"><view class="title">{{item.name}} {{item.id===studentId?'✓':''}}</view><view class="sub">{{item.grade}} · 剩余 {{item.remaining}} 课时</view></view></view></view><view class="sheet-footer"><button class="ghost" bindtap="support">管理关联（联系机构）</button></view></view></view><view wx:if="{{showSupport}}" class="mask"><view class="sheet"><view class="sheet-title">企业微信客服</view><view class="sheet-body center"><image wx:if="{{supportUrl}}" src="{{supportUrl}}" class="qr" mode="aspectFit" show-menu-by-longpress/><view wx:else class="empty">机构尚未配置客服二维码</view><view class="body-text">{{support.text||'约课、调课、报名与缴费由机构线下办理。请通过已知机构联系方式咨询。'}}</view><view class="error" wx:if="{{supportError}}">{{supportError}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeSupport">关闭</button></view></view></view><view class="safe-bottom"/>