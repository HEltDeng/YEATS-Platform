<view wx:if="{{testMode}}" class="test-banner">开发测试环境 · 仅使用受控测试数据</view><view class="student-bar" wx:if="{{student}}"><view class="row grow" bindtap="openStudents"><view class="avatar small">学</view><view>{{student.name}} <text class="small">{{student.grade}} ▾</text></view></view><view bindtap="go" data-page="notifications">通知<text wx:if="{{data.unread}}" class="badge">{{data.unread}}</text></view></view><view wx:if="{{loading}}" class="loading">正在加载…</view><view wx:if="{{error}}" class="error-box"><view>{{error}}</view><button class="ghost" size="mini" bindtap="load">重新加载</button></view><view class="card"><view class="section-title"><view class="dot"/>缺课记录</view><view class="record" wx:for="{{data.absences}}" wx:key="id"><view class="row"><view class="avatar pink">×</view><view class="grow"><view class="title">{{item.title}}</view><view class="sub">{{item.start}} · {{item.teacher}}</view></view></view><view class="row space"><button size="mini" class="ghost" bindtap="support">线下调课</button><button size="mini" class="primary" bindtap="applyOpen" data-id="{{item.id}}">申请线上课程</button></view></view><view class="empty" wx:if="{{!data.absences.length}}">暂无缺课记录</view></view><view class="card"><view class="section-title"><view class="dot"/>可观看的在线课程</view><view wx:for="{{data.grants}}" wx:key="id" class="list-item"><view class="avatar">{{item.available?'▶':'锁'}}</view><view class="grow"><view class="title">{{item.title}}</view><view class="sub">有效期至 {{item.expires}}</view></view><button wx:if="{{item.available}}" class="ghost" size="mini" bindtap="playRecording" data-id="{{item.recording_id}}" data-file="{{item.file_id}}">播放</button><text wx:else class="pill">需重新开通</text></view><view class="empty" wx:if="{{!data.grants.length}}">暂无已开放课程</view><video wx:if="{{videoUrl}}" src="{{videoUrl}}" controls show-center-play-btn show-casting-button="{{false}}" bindtimeupdate="watchTime" binderror="videoError"/></view><view class="card"><view class="section-title"><view class="dot"/>申请记录</view><view class="list-item" wx:for="{{data.requests}}" wx:key="id"><view class="grow"><view class="title">{{item.statusText}}</view><view class="sub">{{item.date}}</view><view class="body-text">{{item.decision_reason||item.reason}}</view></view></view><view class="empty" wx:if="{{!data.requests.length}}">暂无申请</view></view><view wx:if="{{showApply}}" class="mask"><view class="sheet"><view class="sheet-title">申请线上课程观看</view><view class="sheet-body"><view class="sub">提交后由机构审核；通过后按明确的有效期开放。</view><textarea value="{{text}}" bindinput="input" placeholder="填写申请说明（选填）" maxlength="1000"/><view wx:if="{{error}}" class="error">{{error}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeApply">取消</button><button class="primary" bindtap="submitApply" loading="{{busy}}">提交申请</button></view></view></view><view wx:if="{{!student && !loading && !error && name!=='profile' && name!=='settings' && name!=='teachers' && name!=='teacher-detail' && name!=='content' && name!=='me'}}" class="card empty"><view class="title">暂未关联学员</view><view class="sub">请联系机构核对报名时预留的手机号。机构完成预登记后，重新授权即可关联。</view><button class="primary" bindtap="support">联系机构</button></view><view wx:if="{{showStudents}}" class="mask" bindtap="closeStudents"><view class="sheet"><view class="sheet-title">选择学员</view><view class="sheet-body"><view wx:for="{{students}}" wx:key="id" class="list-item {{item.id===studentId?'soft':''}}" bindtap="chooseStudent" data-id="{{item.id}}"><view class="avatar">学</view><view class="grow"><view class="title">{{item.name}} {{item.id===studentId?'✓':''}}</view><view class="sub">{{item.grade}} · 剩余 {{item.remaining}} 课时</view></view></view></view><view class="sheet-footer"><button class="ghost" bindtap="support">管理关联（联系机构）</button></view></view></view><view wx:if="{{showSupport}}" class="mask"><view class="sheet"><view class="sheet-title">企业微信客服</view><view class="sheet-body center"><image wx:if="{{supportUrl}}" src="{{supportUrl}}" class="qr" mode="aspectFit" show-menu-by-longpress/><view wx:else class="empty">机构尚未配置客服二维码</view><view class="body-text">{{support.text||'约课、调课、报名与缴费由机构线下办理。请通过已知机构联系方式咨询。'}}</view><view class="error" wx:if="{{supportError}}">{{supportError}}</view></view><view class="sheet-footer"><button class="ghost" bindtap="closeSupport">关闭</button></view></view></view><view class="safe-bottom"/>