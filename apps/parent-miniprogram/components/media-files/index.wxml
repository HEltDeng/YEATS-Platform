<view class="files"><view class="media-gallery"><view wx:for="{{images}}" wx:key="id" class="media-picture"><image src="{{item.url}}" mode="widthFix" bindtap="open" data-file="{{item}}"/><view class="row between"><text class="hint">{{item.name}}</text><button class="download" size="mini" bindtap="download" data-file="{{item}}">保存图片</button></view></view></view><view wx:for="{{documents}}" wx:key="id" class="file"><view class="row" bindtap="open" data-file="{{item}}"><view class="file-icon">{{item.kind==='video'?'▶':item.kind==='audio'?'♪':item.kind==='image'?'▧':'▤'}}</view><view class="grow"><view class="name">{{item.name}}</view><view class="hint">{{item.kind==='video'?'仅在线播放':'点击查看'}}</view></view><text>›</text></view><button wx:if="{{item.kind!=='video'}}" class="download" size="mini" bindtap="download" data-file="{{item}}">{{item.kind==='image'?'保存图片':'下载文件'}}</button></view><video wx:if="{{playing && kind==='video'}}" src="{{playing}}" show-center-play-btn controls enable-play-gesture="{{false}}" show-casting-button="{{false}}" binderror="mediaError"/><audio wx:if="{{playing && kind==='audio'}}" src="{{playing}}" controls binderror="mediaError"/><view class="hint" wx:if="{{busy}}">正在打开…</view><view class="error" wx:if="{{error}}">{{error}}</view></view>
