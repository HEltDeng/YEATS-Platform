.file{padding:20rpx 0;border-bottom:1rpx solid #f5eada}.row{display:flex;align-items:center;gap:20rpx}.grow{flex:1}.file-icon{width:86rpx;height:86rpx;border-radius:24rpx;background:linear-gradient(135deg,#ffe2b0,#ffc93c);display:flex;align-items:center;justify-content:center;color:#f26a00;font-size:36rpx}.name{font-size:26rpx;color:#3b2a17}.hint{font-size:22rpx;color:#9c8a76;margin-top:8rpx}.download{margin:12rpx 0 0 auto;background:#fff3d6;color:#f26a00;font-size:22rpx}.error{color:#b42318;font-size:24rpx;padding:12rpx}video{width:100%;border-radius:24rpx;margin-top:16rpx}audio{width:100%}

.media-gallery{display:flex;flex-direction:column;gap:18rpx}.media-picture{background:#fff8f0;border-radius:20rpx;overflow:hidden;margin-top:18rpx}.media-picture image{width:100%;min-height:100rpx}.media-picture .row{padding:12rpx;flex-wrap:wrap}.media-picture .download{margin:0}
